# ============================
# SERVER CONFIG
# ============================
PORT=5000
NODE_ENV=development

# ============================
# DATABASE CONFIG (MySQL)
# ============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=realestate_admin
DB_USER=root
DB_PASSWORD=your_mysql_password

# ============================
# JWT AUTH
# ============================
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# ============================
# FRONTEND URL (for CORS)
# ============================
FRONTEND_URL=http://localhost:5173

# ============================
# EXTERNAL APIS (LEAVE EMPTY FOR NOW)
# Jab keys mile, yaha paste kar dena — code khud detect kar lega
# aur real service use karne lag jayega, dummy/mock chhod dega.
# ============================

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMS / OTP (MSG91 example) ---
SMS_API_KEY=
SMS_SENDER_ID=

# --- Email (SMTP / SendGrid) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- WhatsApp API ---
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# --- KYC Verification (Surepass etc.) ---
KYC_API_KEY=
KYC_API_URL=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=
