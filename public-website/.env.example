# ============================================================
# DEVOJAS REALTORS — Backend Connection
# ============================================================
# Ye URL aapke Admin Panel backend ka hai (jo Node.js + Express +
# MySQL se bana hai). Isme "/api" zaroor lagana — humare saare
# routes isi prefix se shuru hote hain.
#
# Local testing ke liye (agar backend aapke computer pe chal raha hai):
VITE_API_BASE_URL=http://localhost:5000/api
#
# Admin Panel ka URL — Admin/Associate/Accounts login karte hi
# automatically yahi Admin Panel pe redirect ho jayenge (SSO):
VITE_ADMIN_PANEL_URL=http://localhost:5173
#
# Live/production backend ke liye (jab backend deploy ho jaye,
# jaise Render/Railway pe), upar wali line hata ke ye use karo:
# VITE_API_BASE_URL=https://your-backend-url.onrender.com/api
# ============================================================
